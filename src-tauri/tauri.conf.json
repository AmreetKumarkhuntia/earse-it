{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Cutout",
  "version": "0.1.0",
  "identifier": "io.github.amreetkumarkhuntia.earseit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "Local Cutout", "width": 1440, "height": 940, "minWidth": 1000, "minHeight": 720, "backgroundColor": "#121714"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": {"enable": true, "scope": []}
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {"resources/worker/": "worker/", "resources/media/": "media/", "../licenses/": "licenses/"},
    "shortDescription": "Select, track, and export video subjects locally",
    "category": "GraphicsAndDesign",
    "windows": {"nsis": {"installMode": "currentUser"}}
  }
}
